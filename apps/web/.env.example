NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Shared with the Edge Functions (supabase secrets set PIPELINE_SECRET=...)
# and Vault ('pipeline_secret'). Generate: openssl rand -hex 32
PIPELINE_SECRET=
# Public site URL for canonical links, sitemap and social previews
NEXT_PUBLIC_SITE_URL=https://example.com
# Show "Continue with Google" only after enabling the Google provider in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH=false
